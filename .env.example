# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
RESEND_API_KEY=
# Model provider (decisions 28 and 29): openai (default), deepseek, gemini, groq, mistral, openrouter,
# openai-compatible or anthropic.
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional. Empty means the provider's default (gpt-5.4-nano, deepseek-flash, gemini-3.5-flash-lite, claude-sonnet-5).
MODEL=
# Optional. A stronger model for the two telegram calls only. OpenAI defaults to gpt-5.4-mini.
MODEL_TELEGRAM=
# Only for openai-compatible, or to point a provider elsewhere.
# LLM_BASE_URL=
# Only for a model missing from packages/pipeline/src/llm/pricing.ts: input,output dollars per million tokens.
# LLM_PRICE_PER_MTOK=0.20,1.25
# Which stages may reason before answering: off, telegram (default) or all.
# LLM_THINKING=telegram
# The day fails if its model spend passes this (spec decision 10).
DAILY_SPEND_CEILING_USD=1.00
# For `npm run stage -- eval`, which can compare providers in one run. Each falls back to LLM_API_KEY.
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Where the Worker is deployed. Email links point here.
WEB_BASE_URL=https://globalgist.<your-subdomain>.workers.dev
# Verified Resend sender.
MAIL_FROM=2DayAI <edition@yourdomain.example>
# Anthropic only: true in production (half price, up to an hour of latency). false for an immediate local run.
LLM_BATCH=false
