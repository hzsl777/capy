# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
RESEND_API_KEY=
# Model provider (decision 28): deepseek (default), gemini, openrouter, openai-compatible or anthropic.
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional. Empty means the provider's default model (deepseek-chat, gemini-2.5-flash, claude-sonnet-5).
MODEL=
# Optional. A stronger model for the two telegram calls only, for example deepseek-reasoner.
MODEL_TELEGRAM=
# Only for openai-compatible, or to point a provider elsewhere.
# LLM_BASE_URL=
# Only for a model missing from packages/pipeline/src/llm/pricing.ts: input,output dollars per million tokens.
# LLM_PRICE_PER_MTOK=0.28,0.42
# The day fails if its model spend passes this (spec decision 10).
DAILY_SPEND_CEILING_USD=0.25
# For `npm run stage -- eval`, which can compare providers in one run. Each falls back to LLM_API_KEY.
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Where the Worker is deployed. Email links point here.
WEB_BASE_URL=https://2dayai.<your-subdomain>.workers.dev
# Verified Resend sender.
MAIL_FROM=2DayAI <edition@yourdomain.example>
# Anthropic only: true in production (half price, up to an hour of latency). false for an immediate local run.
LLM_BATCH=false
