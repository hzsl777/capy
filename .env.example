# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Model is config, not code. Sonnet 5 for the prototype (spec decision 8).
MODEL=claude-sonnet-5
# The daily workflow fails if the day's model spend passes this (spec decision 10).
DAILY_SPEND_CEILING_USD=1.00
