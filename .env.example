# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Model is config, not code. Sonnet 5 for the prototype (spec decision 8).
MODEL=claude-sonnet-5
# The daily workflow fails if the day's model spend passes this (spec decision 10).
DAILY_SPEND_CEILING_USD=1.00
# Where the Worker is deployed. Email links point here.
WEB_BASE_URL=https://2dayai.<your-subdomain>.workers.dev
# Verified Resend sender.
MAIL_FROM=2DayAI <edition@yourdomain.example>
# true in production (half price, up to an hour of latency). false for an immediate local run.
LLM_BATCH=false
