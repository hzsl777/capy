{
  "name": "2dayai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Your day, in one line. One headline per reader, with the stories, explanations, and sources one click down.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "node tools/check-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "stage": "tsx packages/pipeline/src/cli.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "web:dev": "wrangler dev --config packages/web/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
